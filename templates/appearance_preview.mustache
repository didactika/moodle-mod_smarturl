    @template mod_smarturl/appearance_preview
}}
<div class="d-flex flex-wrap align-items-center smu-course-actions" id="smu-preview-{{uniqid}}"
    data-url="{{url}}" data-courseid="{{courseid}}" data-cmid="{{cmid}}" data-sesskey="{{sesskey}}">
    <button type="button" class="btn btn-outline-secondary" data-open><i class="fa fa-eye me-2" aria-hidden="true"></i>{{previewresource}}</button>
    <template>
        <div class="mod-smarturl smu-preview-pane">
        <div class="smu-preview-toolbar d-flex flex-wrap align-items-center gap-2 pb-3 border-bottom">
            <select class="custom-select w-auto" data-surface aria-label="{{previewresource}}">
                <option value="course">{{previewcourse}}</option>
                <option value="activity">{{previewactivity}}</option>
                <option value="auxiliary">{{previewauxiliary}}</option>
            </select>
            <select class="custom-select w-auto" data-language aria-label="{{translationlanguage}}">
                <option value="">{{previewcurrentlanguage}}</option>
                {{#languages}}<option value="{{code}}">{{name}}</option>{{/languages}}
            </select>
            <div class="custom-control custom-switch smu-preview-switch">
                <input id="smu-mobile-{{uniqid}}" class="custom-control-input" type="checkbox" role="switch" data-mobile>
                <label for="smu-mobile-{{uniqid}}" class="custom-control-label">{{previewmobile}}</label>
            </div>
        </div>
        <iframe class="smu-preview-frame" name="smu-preview-frame-{{uniqid}}" title="{{previewresource}}"></iframe>
        </div>
    </template>
</div>
{{#js}}
require(["mod_smarturl/appearance_preview"], function(Preview) { Preview.init("smu-preview-{{uniqid}}"); });
{{/js}}
