    @template mod_smarturl/resource_view
}}
<div class="dd-smarturl-app smu-resource-shell" id="smu-viewer-{{uniqid}}" data-payload="{{payloadjson}}">
    <div class="smu-resource-bar">
        <div class="dd-tags">
            {{#hasduration}}<span class="dd-tag">{{durationlabel}}</span>{{/hasduration}}
            {{#hasmanagedby}}<span class="dd-tag dd-tag-primary">{{managedbadge}}: {{managedby}}</span>{{/hasmanagedby}}
            {{#haslocked}}<span class="dd-tag">{{lockedbadge}}: {{lockedcount}}</span>{{/haslocked}}
        </div>
        {{#isembed}}
        <a class="btn btn-outline-secondary btn-sm" href="{{gourl}}" target="_blank" rel="noopener noreferrer">{{strings.openresource}}</a>
        {{/isembed}}
    </div>

    <section class="smu-stage">
        {{#isembed}}
        <div class="smu-player">{{{playerhtml}}}</div>
        {{/isembed}}

        {{^isembed}}
        <div class="card">{{#hasthumbnail}}<img class="smu-viewer-cover" src="{{thumbnailurl}}" alt="">{{/hasthumbnail}}
            <div class="card-body">
                <div class="smu-facade-actions">
                    {{#ismodal}}
                    <button type="button" class="btn btn-primary" data-action="open-modal">{{strings.launchmodal}}</button>
                    {{/ismodal}}
                    {{#isinline}}
                    <button type="button" class="btn btn-primary" data-action="launch-inline">{{strings.launchiframe}}</button>
                    {{/isinline}}
                    {{#isdirect}}
                    <a class="btn btn-primary" href="{{gourl}}" target="_blank" rel="noopener noreferrer">{{primarylabel}}</a>
                    {{/isdirect}}
                </div>
            </div>
        </div>
        {{/isembed}}
    </section>

    <dialog class="smu-player-dialog" data-region="modal-backdrop" aria-label="{{name}}">
        <div class="card">
            <div class="smu-modal-bar">
                <span class="fw-semibold">{{name}}</span>
                <div>
                    <a class="btn btn-sm btn-outline-secondary" href="{{gourl}}" target="_blank" rel="noopener noreferrer">{{strings.openresource}}</a>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-action="close-modal">{{strings.closepreview}}</button>
                </div>
            </div>
            <div class="smu-frame-wrap">
                <div class="smu-player" data-region="modal-player"></div>
            </div>
        </div>
    </dialog>

    {{#intro}}
    <section class="card card-body smu-description">
        <h2 class="h5">{{strings.description}}</h2>
        <div class="description">{{{intro}}}</div>
    </section>
    {{/intro}}

    {{#hasmetadata}}
    <section class="smu-explorer" aria-label="{{strings.metadataheading}}">
        <div class="smu-meta-toolbar">
            <div class="smu-meta-toprow">
                <h3 class="smu-section-title mb-0">{{strings.metadataheading}} ({{metadatacount}})</h3>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <input type="search"
                           class="form-control smu-meta-search"
                           data-action="search"
                           aria-label="{{strings.metadatasearch}}"
                           placeholder="{{strings.metadatasearchplaceholder}}">
                    <div class="dd-segmented" role="group" aria-label="View mode">
                        <button type="button" class="is-active" data-action="view-mode" data-mode="cards">{{strings.viewcards}}</button>
                        <button type="button" data-action="view-mode" data-mode="table">{{strings.viewtable}}</button>
                    </div>
                    {{#strings.copyjson}}<button type="button" class="btn btn-outline-secondary btn-sm" data-action="copy-json">{{strings.copyjson}}</button>{{/strings.copyjson}}
                </div>
            </div>
            <div class="dd-chips" data-region="group-chips"></div>
        </div>
        <div data-region="results-host"></div>
    </section>
    {{/hasmetadata}}
</div>
{{#js}}
require(['mod_smarturl/resource_view'], function(ResourceView) {
    ResourceView.init('smu-viewer-{{uniqid}}');
});
{{/js}}
