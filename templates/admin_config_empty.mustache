{{!
    @template mod_smarturl/admin_config_empty

    The empty state of a catalogue section. After a search or a filter it says nothing matched and offers to clear them; the
    first time it says what the section holds and offers to create the first item.

    @copyright  2026 Didactika.org
    @license    https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
      "filtered": false,
      "icon": "i/outcomes",
      "title": "No resource fields yet",
      "text": "Fields describe each resource, such as its author or its level.",
      "action": "Add field",
      "clearfilters": "Clear filters"
    }
}}
<div class="d-flex flex-column align-items-center gap-2 px-4 py-5 text-center">
    {{#filtered}}
        <span class="icon-box text-info">{{#pix}}a/search, core{{/pix}}</span>
        <p class="h6 fw-bold mb-0">{{title}}</p>
        <p class="text-muted mb-0">{{text}}</p>
        <button type="button" class="btn btn-outline-secondary mt-2" data-action="clearfilters">{{clearfilters}}</button>
    {{/filtered}}
    {{^filtered}}
        <span class="icon-box">{{#pix}}{{icon}}, core{{/pix}}</span>
        <p class="h6 fw-bold mb-0">{{title}}</p>
        <p class="text-muted mb-0">{{text}}</p>
        <button type="button" class="btn btn-primary mt-2" data-action="add">{{#pix}}t/add, core{{/pix}} {{action}}</button>
    {{/filtered}}
</div>
