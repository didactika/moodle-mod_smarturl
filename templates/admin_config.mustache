    @template mod_smarturl/admin_config
}}
<div class="smu-schema" id="smu-admin-{{uniqid}}" data-payload="{{payloadjson}}">
    <p class="text-body-secondary">{{strings.adminconfigsubtitle}}</p>
    <nav class="nav nav-tabs mb-3" aria-label="{{strings.settings}}">
        {{#sections}}
        <a class="nav-link" href="{{adminUrl}}?tab={{key}}" data-tab="{{key}}">
            {{title}} <span class="badge rounded-pill smu-state" data-count></span>
        </a>
        {{/sections}}
    </nav>
    <div class="alert alert-danger" role="alert" data-error hidden></div>
    <div class="smu-list-toolbar d-flex flex-wrap align-items-center gap-2 mb-3">
        <input type="search" class="form-control" data-search aria-label="{{strings.search}}" placeholder="{{strings.search}}">
        <select class="form-select smu-status-filter" aria-label="{{strings.status}}" data-status>
            <option value="">{{strings.status}}</option>
            <option value="active">{{strings.enabled}}</option>
            <option value="inactive">{{strings.disabled}}</option>
        </select>
        <button type="button" class="btn btn-outline-secondary smu-iconpill" data-clear-status hidden
            aria-label="{{strings.clearfilters}}" title="{{strings.clearfilters}}">{{{clearIcon}}}</button>
        <div class="smu-list-actions d-flex flex-wrap gap-2">
            <a href="{{settingsUrl}}" class="btn btn-outline-secondary"><i class="fa fa-gear" aria-hidden="true"></i> {{strings.settings}}</a>
            <button type="button" class="btn btn-primary" data-add><i class="fa fa-plus" aria-hidden="true"></i> <span></span></button>
        </div>
    </div>
    <div class="card">
        <div class="table-responsive smu-list-table" data-region="tablewrap">
            <table class="table table-hover align-middle mb-0">
                <caption class="visually-hidden"></caption>
                <thead></thead>
                <tbody></tbody>
            </table>
            <div class="p-4 text-center text-body-secondary" data-region="empty" hidden>
                <p></p><button type="button" class="btn btn-outline-secondary" data-empty-action></button>
            </div>
        </div>
        <div class="smu-list-pager border-top px-3 py-2 d-flex align-items-center justify-content-between gap-2 flex-wrap">
            <label class="d-flex align-items-center gap-2 small mb-0">{{strings.pagerlabel}}
                <select class="form-select form-select-sm w-auto" data-size></select>
            </label>
            <div class="d-flex align-items-center gap-2">
                <span class="small text-body-secondary" role="status" data-range></span>
                <button type="button" class="btn btn-link btn-sm" aria-label="{{strings.previous}}" title="{{strings.previous}}" data-prev>
                    {{{previousIcon}}}
                </button>
                <button type="button" class="btn btn-link btn-sm" aria-label="{{strings.next}}" title="{{strings.next}}" data-next>
                    {{{nextIcon}}}
                </button>
            </div>
        </div>
    </div>
</div>
{{#js}}
require(['mod_smarturl/admin_config'], function(AdminConfig) {
    AdminConfig.init('smu-admin-{{uniqid}}');
});
{{/js}}
