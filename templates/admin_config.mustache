<div class="dd-smarturl-app smu-admin" id="smu-admin-{{uniqid}}" data-payload="{{payloadjson}}">
    <header class="dd-page-header">
        <div>
            <h2 class="dd-page-header-title">{{title}}</h2>
            <p class="dd-page-header-sub">{{subtitle}}</p>
        </div>
        <div class="dd-page-header-actions">
            <a class="btn btn-outline-secondary" href="{{settingsurl}}">{{strings.paramdefs}} / Settings</a>
        </div>
    </header>

    <div class="dd-segmented smu-admin-tabs" role="tablist">
        <button type="button" class="is-active" role="tab" data-action="tab" data-tab="metadata">{{strings.metadatatypes}}</button>
        <button type="button" role="tab" data-action="tab" data-tab="params">{{strings.paramdefs}}</button>
        <button type="button" role="tab" data-action="tab" data-tab="preview">{{strings.testresolution}}</button>
    </div>

    <div class="alert alert-danger" role="alert" hidden data-region="error-banner"></div>
    <div class="table-toolbar py-2" role="search">
        <input type="search" class="form-control" data-search aria-label="{{strings.search}}" placeholder="{{strings.search}}">
    </div>

    <section class="smu-admin-panel" data-panel="metadata">
        <form class="smu-admin-form" data-form="meta-type">
            <input type="hidden" name="id" value="0">
            <div class="smu-form-grid">
                <label>{{strings.shortname}}
                    <input class="form-control" name="shortname" required placeholder="e.g. curriculum_code">
                </label>
                <label>Name
                    <input class="form-control" name="name" required placeholder="e.g. Curriculum code">
                </label>
                <label>{{strings.groupname}}
                    <select class="custom-select" name="categoryid">
                        <option value="0">{{strings.groupname}}</option>
                        {{#categories}}<option value="{{id}}">{{name}}</option>{{/categories}}
                    </select>
                </label>
                <label>{{strings.datatype}}
                    <select class="form-control" name="datatype">
                        {{#datatypes}}<option value="{{value}}">{{value}}</option>{{/datatypes}}
                    </select>
                </label>
                <label>{{strings.priority}}
                    <select class="form-control" name="display_priority">
                        {{#priorities}}<option value="{{value}}">{{value}}</option>{{/priorities}}
                    </select>
                </label>
                <div class="smu-check-row">
                    <label><input type="checkbox" name="searchable" checked> {{strings.searchable}}</label>
                    <label><input type="checkbox" name="filterable" checked> {{strings.filterable}}</label>
                    <label><input type="checkbox" name="enabled" checked> {{strings.enabled}}</label>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">{{strings.addmetatype}}</button>
        </form>
        <div class="table-responsive" data-region="tablewrap">
            <table class="table table-hover smu-table mb-0">
                <thead>
                    <tr>
                        <th scope="col">{{strings.shortname}}</th>
                        <th scope="col">Name</th>
                        <th scope="col">{{strings.groupname}}</th>
                        <th scope="col">{{strings.datatype}}</th>
                        <th scope="col">{{strings.priority}}</th>
                        <th scope="col">{{strings.enabled}}</th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody data-region="meta-tbody"></tbody>
            </table>
        </div>
    </section>

    <section class="smu-admin-panel" data-panel="params" hidden>
        <form class="smu-admin-form" data-form="param-def">
            <input type="hidden" name="id" value="0">
            <div class="smu-form-grid">
                <label>{{strings.shortname}}
                    <input class="form-control" name="shortname" required placeholder="e.g. campus_code">
                </label>
                <label>Name
                    <input class="form-control" name="name" required placeholder="e.g. User campus field">
                </label>
                <label>{{strings.sourcetype}}
                    <select class="form-control" name="source_type">
                        {{#sourcetypes}}<option value="{{value}}">{{value}}</option>{{/sourcetypes}}
                    </select>
                </label>
                <label>{{strings.sourcekey}}
                    <input class="form-control" name="source_key" data-source-key required>
                    <select class="custom-select" data-source-options aria-label="{{strings.sourcekey}}" hidden></select>
                </label>
                <label>{{strings.defaultqueryparam}}
                    <input class="form-control" name="default_query_param" placeholder="optional query param">
                </label>
                <div class="smu-check-row">
                    <label><input type="checkbox" name="enabled" checked> {{strings.enabled}}</label>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">{{strings.addparamdef}}</button>
        </form>
        <div class="table-responsive" data-region="tablewrap">
            <table class="table table-hover smu-table mb-0">
                <thead>
                    <tr>
                        <th scope="col">{{strings.shortname}}</th>
                        <th scope="col">Name</th>
                        <th scope="col">{{strings.sourcetype}}</th>
                        <th scope="col">{{strings.sourcekey}}</th>
                        <th scope="col">{{strings.enabled}}</th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody data-region="param-tbody"></tbody>
            </table>
        </div>
    </section>

    <section class="smu-admin-panel" data-panel="preview" hidden>
        <form class="smu-admin-form" data-form="preview">
            <div class="smu-form-grid">
                <label>Template URL
                    <input class="form-control" name="template" value="https://video.example.org/watch/{{=<% %>=}}{{course_shortname}}<%={{ }}=%>?u={{=<% %>=}}{{user_username}}<%={{ }}=%>">
                </label>
                <label>Query Param
                    <input class="form-control" name="bind_param" value="env">
                </label>
                <label>Static Value
                    <input class="form-control" name="bind_val" value="demo">
                </label>
            </div>
            <button type="submit" class="btn btn-primary">{{strings.testresolution}}</button>
            <div class="smu-preview-out" hidden data-region="preview-out">
                <code></code>
            </div>
        </form>
    </section>
</div>
{{#js}}
require(['mod_smarturl/admin_config'], function(AdminConfig) {
    AdminConfig.init('smu-admin-{{uniqid}}');
});
{{/js}}
