    @template mod_smarturl/course_preview
}}
<details class="smu-course-inline" id="smu-course-preview-{{uniqid}}">
    <summary class="btn btn-outline-secondary">{{label}}</summary>
    <template>{{{player}}}</template>
    <div class="smu-course-iframe-wrap" data-region="player"></div>
</details>
{{#js}}
require(['mod_smarturl/course_preview'], function(Preview) { Preview.init('smu-course-preview-{{uniqid}}', {{cmid}}); });
{{/js}}
